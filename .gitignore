# Build output
*.o
*.d
*.a
*.so
*.out
*.elf
*.bin
*.iso
build/
target/
cmake-build-*/

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Linux executables have no extension. In practicum, capstone and lib folders,
# ignore every extensionless file except Makefiles.
/unit*/**/*
/bridge*/**/*
/capstone*/**/*
/lib/**/*
!/unit*/**/*/
!/bridge*/**/*/
!/capstone*/**/*/
!/lib/**/*/
!/unit*/**/*.*
!/bridge*/**/*.*
!/capstone*/**/*.*
!/lib/**/*.*
# The !*.* lines above re-include every dotted file; re-ignore build output and swap files.
*.o
*.d
*.swp
*.swo
!Makefile
!makefile
